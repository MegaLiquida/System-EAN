<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Desempenho de Usuários - Sistema EAN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background-color: #f8f9fa;
            padding-top: 20px;
            padding-bottom: 20px;
        }
        .navbar {
            margin-bottom: 20px;
        }
        .card {
            margin-bottom: 20px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
        .stats-card {
            border-left: 4px solid #007bff;
        }
        .stats-card.success {
            border-left-color: #28a745;
        }
        .stats-card.warning {
            border-left-color: #ffc107;
        }
        .stats-card.info {
            border-left-color: #17a2b8;
        }
        .stats-card.danger {
            border-left-color: #dc3545;
        }
        .stats-number {
            font-size: 2rem;
            font-weight: bold;
            color: #007bff;
        }
        .stats-label {
            color: #6c757d;
            font-size: 0.9rem;
        }
        .user-row:hover {
            background-color: #f8f9fa;
        }
        .badge-custom {
            font-size: 0.8rem;
        }
        .chart-container {
            position: relative;
            height: 400px;
            margin-bottom: 20px;
        }
        .filter-section {
            background-color: #e9ecef;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .table-responsive {
            border-radius: 8px;
            overflow: hidden;
        }
        .no-data {
            text-align: center;
            color: #6c757d;
            font-style: italic;
            padding: 40px;
        }
        .refresh-btn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1000;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ url_for('admin.dashboard') }}">
                <i class="bi bi-arrow-left"></i> Painel Administrativo
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('admin.dashboard') }}">
                            <i class="bi bi-list-ul"></i> Listas Enviadas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('admin.listas_unificadas') }}">
                            <i class="bi bi-collection"></i> Listas Unificadas
                        </a>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link">Olá, {{ session.usuario_nome }}</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('auth.logout') }}">Sair</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">
                    <i class="bi bi-graph-up"></i> Painel de Desempenho de Usuários
                </h2>
            </div>
        </div>

        <!-- Filtros -->
        <div class="filter-section">
            <form method="GET" action="{{ url_for('painel_desempenho') }}" class="row g-3">
                <div class="col-md-2">
                    <label for="periodo" class="form-label">Período (dias)</label>
                    <select class="form-select" id="periodo" name="periodo">
                        <option value="1" {% if periodo_dias == 1 %}selected{% endif %}>Último dia</option>
                        <option value="3" {% if periodo_dias == 3 %}selected{% endif %}>Últimos 3 dias</option>
                        <option value="7" {% if periodo_dias == 7 %}selected{% endif %}>Últimos 7 dias</option>
                        <option value="15" {% if periodo_dias == 15 %}selected{% endif %}>Últimos 15 dias</option>
                        <option value="30" {% if periodo_dias == 30 %}selected{% endif %}>Últimos 30 dias</option>
                        <option value="custom" {% if filtro_customizado %}selected{% endif %}>Personalizado</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="data_inicio" class="form-label">Data Início</label>
                    <input type="date" class="form-control" id="data_inicio" name="data_inicio" 
                           value="{{ data_inicio }}">
                </div>
                <div class="col-md-2">
                    <label for="data_fim" class="form-label">Data Fim</label>
                    <input type="date" class="form-control" id="data_fim" name="data_fim" 
                           value="{{ data_fim }}">
                </div>
                <div class="col-md-4">
                    <label for="usuario" class="form-label">Filtrar por usuário</label>
                    <input type="text" class="form-control" id="usuario" name="usuario" 
                           placeholder="Digite o nome do usuário" value="{{ usuario_filtro }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                    </div>
                </div>
            </form>
            {% if usuario_filtro or periodo_dias != 7 or filtro_customizado %}
            <div class="mt-2">
                <a href="{{ url_for('painel_desempenho') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle"></i> Limpar Filtros
                </a>
            </div>
            {% endif %}
        </div>

        <!-- Estatísticas Gerais -->
        <div class="row">
            <div class="col-md-3">
                <div class="card stats-card">
                    <div class="card-body text-center">
                        <div class="stats-number">{{ estatisticas_gerais.total_usuarios_ativos }}</div>
                        <div class="stats-label">Usuários Ativos</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card success">
                    <div class="card-body text-center">
                        <div class="stats-number text-success">{{ estatisticas_gerais.total_produtos }}</div>
                        <div class="stats-label">Mercado Livre</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card warning">
                    <div class="card-body text-center">
                        <div class="stats-number text-warning">{{ estatisticas_gerais.total_enviados }}</div>
                        <div class="stats-label">Loja</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card danger">
                    <div class="card-body text-center">
                        <div class="stats-number text-danger">{{ estatisticas_gerais.total_validados }}</div>
                        <div class="stats-label">Manutenção</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Listas Aprovadas por Responsável -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-check-circle"></i> Listas Aprovadas por Responsável
                    {% if filtro_customizado %}
                        <small class="text-muted">(Período personalizado)</small>
                    {% elif periodo_dias == 1 %}
                        <small class="text-muted">(Último dia)</small>
                    {% elif periodo_dias|int < 30 %}
                        <small class="text-muted">(Últimos {{ periodo_dias }} dias)</small>
                    {% else %}
                        <small class="text-muted">(Últimos 30 dias)</small>
                    {% endif %}
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    {% for responsavel in listas_aprovadas_responsavel %}
                    <div class="col-md-3">
                        <div class="card stats-card">
                            <div class="card-body text-center">
                                <div class="stats-number text-primary">{{ responsavel.listas_aprovadas }}</div>
                                <div class="stats-label">{{ responsavel.nome }}</div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Gráficos -->
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-bar-chart"></i> Top 10 Usuários por Produtos
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="graficoUsuarios"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-graph-up"></i> Atividade por Dia
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="graficoAtividade"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabela de Usuários -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-people"></i> Desempenho Detalhado por Usuário
                    {% if filtro_customizado %}
                        <small class="text-muted">(Período personalizado)</small>
                    {% elif periodo_dias == 1 %}
                        <small class="text-muted">(Último dia)</small>
                    {% elif periodo_dias|int < 30 %}
                        <small class="text-muted">(Últimos {{ periodo_dias }} dias)</small>
                    {% else %}
                        <small class="text-muted">(Últimos 30 dias)</small>
                    {% endif %}
                </h5>
            </div>
            <div class="card-body">
                {% if metricas_usuarios %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Usuário</th>
                                <th class="text-center">Mercado Livre</th>
                                <th class="text-center">Loja</th>
                                <th class="text-center">Manutenção</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Última Atividade</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for usuario in metricas_usuarios %}
                            <tr class="user-row">
                                <td>
                                    <strong>{{ usuario.nome }}</strong>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning badge-custom">{{ usuario.total_mercado_livre }}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary badge-custom">{{ usuario.total_loja }}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-danger badge-custom">{{ usuario.total_manutencao }}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info badge-custom">{{ usuario.total_geral_enviado }}</span>
                                </td>
                                <td class="text-center">
                                    {% if usuario.ultima_atividade %}
                                        <small class="text-muted">
                                            {{ usuario.ultima_atividade|data_brasileira }}
                                        </small>
                                    {% else %}
                                        <small class="text-muted">Sem atividade</small>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="no-data">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #dee2e6;"></i>
                    <p class="mt-3">Nenhum dado encontrado para o período selecionado.</p>
                    {% if usuario_filtro %}
                    <p>Tente remover o filtro de usuário ou alterar o período.</p>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>



    <!-- Botão de Atualização -->
    <button type="button" class="btn btn-primary btn-lg refresh-btn" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i>
    </button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Configuração dos gráficos
        document.addEventListener('DOMContentLoaded', function() {
            // Gráfico de usuários
            carregarGraficoUsuarios();
            
            // Gráfico de atividade
            carregarGraficoAtividade();
        });

        function carregarGraficoUsuarios() {
            const periodo = {% if filtro_customizado %}"custom"{% else %}{{ periodo_dias }}{% endif %};
            let url = `/admin/desempenho/api/grafico?tipo=usuarios&periodo=${periodo}`;
            
            {% if filtro_customizado %}
            const dataInicio = "{{ data_inicio }}";
            const dataFim = "{{ data_fim }}";
            if (dataInicio && dataFim) {
                url += `&data_inicio=${encodeURIComponent(dataInicio)}&data_fim=${encodeURIComponent(dataFim)}`;
            }
            {% endif %}
            
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const ctx = document.getElementById('graficoUsuarios').getContext('2d');
                        new Chart(ctx, {
                            type: 'bar',
                            data: data.dados,
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        position: 'top',
                                    },
                                    title: {
                                        display: false
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: {
                                            stepSize: 1
                                        }
                                    }
                                }
                            }
                        });
                    }
                })
                .catch(error => {
                    console.error('Erro ao carregar gráfico de usuários:', error);
                });
        }

        function carregarGraficoAtividade() {
            const periodo = {% if filtro_customizado %}"custom"{% else %}{{ periodo_dias }}{% endif %};
            let url = `/admin/desempenho/api/grafico?tipo=atividade&periodo=${periodo}`;
            
            {% if filtro_customizado %}
            const dataInicio = "{{ data_inicio }}";
            const dataFim = "{{ data_fim }}";
            if (dataInicio && dataFim) {
                url += `&data_inicio=${encodeURIComponent(dataInicio)}&data_fim=${encodeURIComponent(dataFim)}`;
            }
            {% endif %}
            
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const ctx = document.getElementById('graficoAtividade').getContext('2d');
                        new Chart(ctx, {
                            type: 'line',
                            data: data.dados,
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        position: 'top',
                                    },
                                    title: {
                                        display: false
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: {
                                            stepSize: 1
                                        }
                                    }
                                }
                            }
                        });
                    }
                })
                .catch(error => {
                    console.error('Erro ao carregar gráfico de atividade:', error);
                });
        }

        // Controle dos campos de data personalizada
        function toggleCustomDateFields() {
            const periodoSelect = document.getElementById('periodo');
            const dataInicioField = document.getElementById('data_inicio');
            const dataFimField = document.getElementById('data_fim');
            
            if (periodoSelect && dataInicioField && dataFimField) {
                if (periodoSelect.value === 'custom') {
                    dataInicioField.disabled = false;
                    dataFimField.disabled = false;
                    dataInicioField.required = true;
                    dataFimField.required = true;
                } else {
                    dataInicioField.disabled = true;
                    dataFimField.disabled = true;
                    dataInicioField.required = false;
                    dataFimField.required = false;
                    dataInicioField.value = '';
                    dataFimField.value = '';
                }
            }
        }

        // Inicializar quando o DOM estiver carregado
        document.addEventListener('DOMContentLoaded', function() {
            // Pequeno delay para garantir que todos os elementos estejam carregados
            setTimeout(function() {
                // Adicionar event listener para o select de período
                const periodoSelect = document.getElementById('periodo');
                if (periodoSelect) {
                    periodoSelect.addEventListener('change', toggleCustomDateFields);
                    // Executar na inicialização
                    toggleCustomDateFields();
                    console.log('Filtro de data/hora inicializado');
                }
            }, 100);
        });
    </script>
</body>
</html>

