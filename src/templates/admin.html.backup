<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Administrativo - Sistema de Cadastro de Produtos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            padding-top: 20px;
            padding-bottom: 20px;
        }
        .navbar {
            margin-bottom: 20px;
        }
        
        /* Estilos para o dropdown menu */
        .dropdown-menu {
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            min-width: 250px;
        }
        
        .dropdown-item {
            padding: 10px 20px;
            transition: all 0.2s ease;
        }
        
        .dropdown-item:hover {
            background-color: #f8f9fa;
            color: #007bff;
            transform: translateX(5px);
        }
        
        .dropdown-item i {
            width: 20px;
            margin-right: 10px;
        }
        
        .dropdown-divider {
            margin: 5px 0;
            border-color: #e9ecef;
        }
        
        .nav-link {
            transition: color 0.2s ease;
        }
        
        .nav-link:hover {
            color: #007bff !important;
        }
        .card {
            margin-bottom: 20px;
        }
        .lista-header {
            background-color: #f0f0f0;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 5px;
            border-left: 5px solid #007bff;
        }
        .lista-info {
            font-size: 0.9rem;
            color: #666;
        }
        .lista-usuario {
            font-weight: bold;
            color: #007bff;
        }
        .lista-data {
            font-style: italic;
        }
        .accordion-button:not(.collapsed) {
            background-color: #e7f1ff;
            color: #0c63e4;
        }
        .validado {
            background-color: #d4edda;
            border-left: 5px solid #28a745;
        }
        .nao-validado {
            background-color: #fff3cd;
            border-left: 5px solid #ffc107;
        }
        .validacao-info {
            font-size: 0.85rem;
            margin-top: 5px;
            padding: 5px 10px;
            border-radius: 3px;
        }
        .validacao-badge {
            font-weight: bold;
            color: #28a745;
        }
        #notification {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: none;
        }
        .search-highlight {
            background-color: #ffff00;
            font-weight: bold;
        }
        .search-container {
            margin-bottom: 20px;
        }
        .search-results-info {
            margin-top: 10px;
            margin-bottom: 20px;
            padding: 10px;
            background-color: #e9ecef;
            border-radius: 5px;
            font-size: 0.9rem;
        }
        .responsavel-info {
            font-size: 0.85rem;
            color: #6c757d;
            margin-left: 10px;
        }
        .responsavel-badge {
            background-color: #e2f3ff;
            color: #0d6efd;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
            margin-left: 5px;
        }
        .batch-actions {
            position: sticky;
            top: 20px;
            z-index: 100;
            margin-bottom: 20px;
        }
        .lista-checkbox {
            margin-right: 10px;
        }
        .accordion-header .form-check {
            margin-right: 15px;
        }
        .accordion-header .form-check-input {
            margin-top: 0;
        }
        .selected-count {
            font-weight: bold;
            color: #0d6efd;
        }
        /* Estilos personalizados para o date picker */
        .date-picker-input {
            cursor: pointer;
        }
        .calendar-button {
            border-left: 0;
            background-color: #17a2b8;
            border-color: #17a2b8;
        }
        .calendar-button:hover {
            background-color: #138496;
            border-color: #117a8b;
        }
        /* Customização do Flatpickr */
        .flatpickr-calendar {
            z-index: 1060 !important;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">Painel Administrativo</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <!-- Menu Dropdown para Painéis - DESABILITADO (rotas não implementadas) -->
                    <!-- <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="paineisDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-3x3-gap"></i> Painéis
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="paineisDropdown">
                            <li>
                                <a class="dropdown-item" href="{{ url_for('admin.painel_desempenho') }}">
                                    <i class="bi bi-graph-up"></i> Desempenho de Usuários
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('admin.estoque_local') }}">
                                    <i class="bi bi-box-seam"></i> Estoque Local
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('admin.listas_unificadas') }}">
                                    <i class="bi bi-collection"></i> Listas Unificadas
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('admin.stand_by') }}">
                                    <i class="bi bi-pause-circle"></i> Stand-by
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('admin.painel_loja') }}">
                                    <i class="bi bi-shop"></i> Loja
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('admin.painel_manutencao') }}">
                                    <i class="bi bi-tools"></i> Manutenção
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('admin.gerenciar_usuarios') }}">
                                    <i class="bi bi-people-fill"></i> Desenvolvedores
                                </a>
                            </li>
                        </ul>
                    </li> -->
                    
                    <!-- Informações do usuário -->
                    <li class="nav-item">
                        <span class="nav-link">
                            <i class="bi bi-person-circle"></i> Olá, {{ session.usuario_nome }}
                        </span>
                    </li>
                    
                    <!-- Botão Sair -->
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('auth.logout') }}">
                            <i class="bi bi-box-arrow-right"></i> Sair
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div id="notification" class="alert alert-dismissible fade show">
            <span id="notification-message"></span>
            <button type="button" class="btn-close" onclick="hideNotification()"></button>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">Listas de Produtos Enviadas</h5>
                    </div>
                    <div class="card-body">
                        <!-- Campo de pesquisa -->
                        <div class="search-container">
                            <form action="{{ url_for('admin.dashboard') }}" method="GET" class="row g-3">
                                <div class="col-md-10">
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="pesquisa" id="pesquisa" 
                                               placeholder="Pesquisar por EAN ou palavra-chave na descrição" 
                                               value="{{ termo_pesquisa }}">
                                        <button class="btn btn-primary" type="submit">
                                            <i class="bi bi-search"></i> Pesquisar
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    {% if termo_pesquisa %}
                                    <a href="{{ url_for('admin.dashboard') }}" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-x-circle"></i> Limpar
                                    </a>
                                    {% endif %}
                                </div>
                            </form>
                            
                            <!-- Campo de busca por data com Date Picker -->
                            <div class="row g-3 mt-3">
                                <div class="col-md-12">
                                    <h6 class="text-muted">Buscar por Data</h6>
                                </div>
                                <div class="col-md-4">
                                    <form action="{{ url_for("admin.dashboard") }}" method="GET" class="d-flex" id="form_data_unica">
                                        <div class="input-group">
                                            <input type="text" class="form-control date-picker-input" name="data" id="data_busca" 
                                                   placeholder="dd/mm/aaaa" 
                                                   value="{{ data_busca }}"
                                                   readonly>
                                            <button class="btn btn-info calendar-button" type="button" id="data_busca_btn">
                                                <i class="bi bi-calendar-date"></i> Buscar Data
                                            </button>
                                        </div>
                                    </form>
                                </div>
                                <div class="col-md-6">
                                    <form action="{{ url_for("admin.dashboard") }}" method="GET" class="d-flex" id="form_periodo">
                                        <div class="input-group">
                                            <input type="text" class="form-control date-picker-input" name="data_inicio" id="data_inicio" 
                                                   placeholder="Data início (dd/mm/aaaa)" 
                                                   value="{{ data_inicio }}"
                                                   readonly>
                                            <input type="text" class="form-control date-picker-input" name="data_fim" id="data_fim" 
                                                   placeholder="Data fim (dd/mm/aaaa)" 
                                                   value="{{ data_fim }}"
                                                   readonly>
                                            <button class="btn btn-info calendar-button" type="button" id="periodo_busca_btn">
                                                <i class="bi bi-calendar-range"></i> Buscar Período
                                            </button>
                                        </div>
                                    </form>
                                </div>
                                <div class="col-md-2">
                                    {% if data_busca or (data_inicio and data_fim) %}
                                    <a href="{{ url_for('admin.dashboard') }}" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-x-circle"></i> Limpar Data
                                    </a>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <!-- Filtro por Criador de Lista -->
                            <div class="row g-3 mt-3">
                                <div class="col-md-12">
                                    <h6 class="text-muted">Filtrar por Criador</h6>
                                </div>
                                <div class="col-md-8">
                                    <form action="{{ url_for("admin.dashboard") }}" method="GET" class="d-flex" id="form_criador">
                                        <!-- Manter filtros de data se existirem -->
                                        {% if data_busca %}
                                        <input type="hidden" name="data" value="{{ data_busca }}">
                                        {% endif %}
                                        {% if data_inicio and data_fim %}
                                        <input type="hidden" name="data_inicio" value="{{ data_inicio }}">
                                        <input type="hidden" name="data_fim" value="{{ data_fim }}">
                                        {% endif %}
                                        
                                        <div class="input-group">
                                            <input type="text" class="form-control" name="criador" id="criador_filtro" 
                                                   placeholder="Digite o nome do usuário criador..." 
                                                   value="{{ criador_filtro }}"
                                                   autocomplete="off">
                                            <button class="btn btn-primary" type="submit">
                                                <i class="bi bi-person-search"></i> Filtrar por Criador
                                            </button>
                                        </div>
                                    </form>
                                </div>
                                <div class="col-md-4">
                                    {% if criador_filtro %}
                                    <a href="{{ url_for('admin', data=data_busca, data_inicio=data_inicio, data_fim=data_fim) }}" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-x-circle"></i> Limpar Filtro Criador
                                    </a>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <!-- Separador visual -->
                            <hr class="my-3">
                        </div>

                        <!-- Informações de resultados da pesquisa -->
                        {% if termo_pesquisa or tipo_busca or criador_filtro %}
                        <div class="search-results-info">
                            {% if criador_filtro %}
                                {% if listas_agrupadas %}
                                    <i class="bi bi-person-check"></i> 
                                    Resultados filtrados por criador "<strong>{{ criador_filtro }}</strong>" - 
                                    Encontrados produtos em {{ paginacao.total_listas }} lista(s)
                                    {% if paginacao.total_listas > paginacao.por_pagina %}
                                        (Exibindo {{ listas_agrupadas|length }} de {{ paginacao.total_listas }})
                                    {% endif %}
                                {% else %}
                                    <i class="bi bi-exclamation-triangle"></i> 
                                    Nenhum resultado encontrado para o criador "<strong>{{ criador_filtro }}</strong>"
                                {% endif %}
                            {% elif termo_pesquisa %}
                                {% if listas_agrupadas %}
                                    <i class="bi bi-info-circle"></i> 
                                    Resultados da pesquisa por "<strong>{{ termo_pesquisa }}</strong>" - 
                                    Encontrados produtos em {{ paginacao.total_listas }} lista(s)
                                    {% if paginacao.total_listas > paginacao.por_pagina %}
                                        (Exibindo {{ listas_agrupadas|length }} de {{ paginacao.total_listas }})
                                    {% endif %}
                                {% else %}
                                    <i class="bi bi-exclamation-triangle"></i> 
                                    Nenhum resultado encontrado para "<strong>{{ termo_pesquisa }}</strong>"
                                {% endif %}
                            {% elif tipo_busca == 'data' %}
                                {% if listas_agrupadas %}
                                    <i class="bi bi-calendar-check"></i> 
                                    Resultados para a data "<strong>{{ termo_busca }}</strong>" - 
                                    Encontrados produtos em {{ paginacao.total_listas }} lista(s)
                                    {% if paginacao.total_listas > paginacao.por_pagina %}
                                        (Exibindo {{ listas_agrupadas|length }} de {{ paginacao.total_listas }})
                                    {% endif %}
                                {% else %}
                                    <i class="bi bi-exclamation-triangle"></i> 
                                    Nenhum resultado encontrado para a data "<strong>{{ termo_busca }}</strong>"
                                {% endif %}
                            {% elif tipo_busca == 'periodo' %}
                                {% if listas_agrupadas %}
                                    <i class="bi bi-calendar-range"></i> 
                                    Resultados para o período "<strong>{{ termo_busca }}</strong>" - 
                                    Encontrados produtos em {{ paginacao.total_listas }} lista(s)
                                    {% if paginacao.total_listas > paginacao.por_pagina %}
                                        (Exibindo {{ listas_agrupadas|length }} de {{ paginacao.total_listas }})
                                    {% endif %}
                                {% else %}
                                    <i class="bi bi-exclamation-triangle"></i> 
                                    Nenhum resultado encontrado para o período "<strong>{{ termo_busca }}</strong>"
                                {% endif %}
                            {% endif %}
                        </div>
                        {% else %}
                        <!-- Informações de paginação quando não há pesquisa -->
                        {% if paginacao and paginacao.total_listas > 0 %}
                        <div class="search-results-info">
                            <i class="bi bi-list-ul"></i> 
                            Total de {{ paginacao.total_listas }} lista(s) enviada(s)
                            {% if paginacao.total_listas > paginacao.por_pagina %}
                                - Exibindo {{ listas_agrupadas|length }} lista(s) (Página {{ paginacao.pagina_atual }} de {{ paginacao.total_paginas }})
                            {% endif %}
                        </div>
                        {% endif %}
                        {% endif %}

                        <!-- Controles de seleção em lote -->
                        <div class="batch-actions card">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="selectAllNaoValidadas">
                                            <label class="form-check-label" for="selectAllNaoValidadas">
                                                <strong>Selecionar todas as listas não validadas</strong>
                                            </label>
                                        </div>
                                        <small class="text-muted">
                                            <span class="selected-count" id="selectedCount">0</span> lista(s) selecionada(s)
                                        </small>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <button type="button" class="btn btn-outline-secondary btn-sm me-2" id="clearSelectionBtn">
                                            <i class="bi bi-x-circle"></i> Limpar Seleção
                                        </button>
                                        <button type="button" class="btn btn-success" id="validateSelectedBtn" disabled>
                                            <i class="bi bi-check-circle"></i> Validar Listas Selecionadas
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {% if listas_agrupadas %}
                            <div class="accordion" id="listasAccordion">
                                {% for lista in listas_agrupadas %}
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="heading{{ loop.index }}">
                                            <button class="accordion-button {% if not loop.first and not termo_pesquisa %}collapsed{% endif %} {% if lista.validado %}validado{% else %}nao-validado{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ loop.index }}" aria-expanded="{{ 'true' if loop.first or termo_pesquisa else 'false' }}" aria-controls="collapse{{ loop.index }}">
                                                {% if not lista.validado %}
                                                <div class="form-check lista-checkbox" onclick="event.stopPropagation();">
                                                    <input class="form-check-input lista-select" type="checkbox" 
                                                           data-data-envio="{{ lista.data_envio }}" 
                                                           data-nome-usuario="{{ lista.nome_usuario }}"
                                                           id="lista_{{ loop.index }}">
                                                </div>
                                                {% endif %}
                                                <div class="d-flex justify-content-between w-100">
                                                    <span>
                                                        Lista de <span class="lista-usuario">{{ lista.nome_usuario }}</span>
                                                        {% if lista.nome_responsavel %}
                                                        <span class="responsavel-badge">
                                                            <i class="bi bi-person-check"></i> Resp: {{ lista.nome_responsavel }}
                                                        </span>
                                                        {% endif %}
                                                    </span>
                                                    <div class="d-flex align-items-center">
                                                        {% if lista.validado %}
                                                            <span class="badge bg-success me-2">Validada</span>
                                                        {% else %}
                                                            <span class="badge bg-warning me-2">Pendente</span>
                                                        {% endif %}
                                                        <span class="lista-data">{{ lista.data_envio|data_brasileira }}</span>
                                                    </div>
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="collapse{{ loop.index }}" class="accordion-collapse collapse {% if loop.first or termo_pesquisa %}show{% endif %}" aria-labelledby="heading{{ loop.index }}" data-bs-parent="#listasAccordion">
                                            <div class="accordion-body">
                                                {% if lista.validado %}
                                                    <div class="validacao-info bg-light">
                                                        <i class="bi bi-check-circle-fill text-success"></i> 
                                                        Validada por <span class="validacao-badge">{{ lista.nome_validador }}</span> em {{ lista.data_validacao|data_brasileira }}
                                                    </div>
                                                {% else %}
                                                    <div class="d-flex justify-content-end mb-3">
                                                        <button class="btn btn-success btn-sm validar-btn" 
                                                                data-data-envio="{{ lista.data_envio }}" 
                                                                data-nome-usuario="{{ lista.nome_usuario }}">
                                                            <i class="bi bi-check-lg"></i> Validar Lista
                                                        </button>
                                                    </div>
                                                {% endif %}
                                                
                                                <div class="table-responsive">
                                                    <table class="table table-striped table-hover">
                                                        <thead>
                                                            <tr>
                                                                <th>EAN</th>
                                                                <th>Nome</th>
                                                                <th>Cor</th>
                                                                <th>Voltagem</th>
                                                                <th>Modelo</th>
                                                                <th>Quantidade</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            {% for produto in lista.produtos %}
                                                                <tr class="{% if termo_pesquisa and (termo_pesquisa in produto.ean or termo_pesquisa.lower() in produto.nome.lower() or termo_pesquisa.lower() in produto.cor.lower() or termo_pesquisa.lower() in produto.modelo.lower()) %}search-highlight{% endif %}">
                                                                    <td>{{ produto.ean }}</td>
                                                                    <td>{{ produto.nome }}</td>
                                                                    <td>{{ produto.cor }}</td>
                                                                    <td>{{ produto.voltagem }}</td>
                                                                    <td>{{ produto.modelo }}</td>
                                                                    <td>{{ produto.quantidade }}</td>
                                                                </tr>
                                                            {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            
                            <!-- Controles de Paginação -->
                            {% if paginacao and paginacao.total_paginas > 1 %}
                            <div class="d-flex justify-content-center mt-4">
                                <nav aria-label="Navegação de páginas">
                                    <ul class="pagination">
                                        <!-- Botão Primeira Página -->
                                        {% if paginacao.pagina_atual > 1 %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ url_for('admin', pagina=1, pesquisa=termo_pesquisa, criador=criador_filtro, data=data_busca, data_inicio=data_inicio, data_fim=data_fim) }}" aria-label="Primeira página">
                                                <i class="bi bi-chevron-double-left"></i>
                                            </a>
                                        </li>
                                        {% else %}
                                        <li class="page-item disabled">
                                            <span class="page-link" aria-label="Primeira página">
                                                <i class="bi bi-chevron-double-left"></i>
                                            </span>
                                        </li>
                                        {% endif %}
                                        
                                        <!-- Botão Página Anterior -->
                                        {% if paginacao.tem_anterior %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ url_for('admin', pagina=paginacao.pagina_atual-1, pesquisa=termo_pesquisa, criador=criador_filtro, data=data_busca, data_inicio=data_inicio, data_fim=data_fim) }}" aria-label="Página anterior">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                        {% else %}
                                        <li class="page-item disabled">
                                            <span class="page-link" aria-label="Página anterior">
                                                <i class="bi bi-chevron-left"></i>
                                            </span>
                                        </li>
                                        {% endif %}
                                        
                                        <!-- Números das páginas -->
                                        {% set start_page = [1, paginacao.pagina_atual - 2]|max %}
                                        {% set end_page = [paginacao.total_paginas, paginacao.pagina_atual + 2]|min %}
                                        
                                        {% if start_page > 1 %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ url_for('admin', pagina=1, pesquisa=termo_pesquisa, criador=criador_filtro, data=data_busca, data_inicio=data_inicio, data_fim=data_fim) }}">1</a>
                                        </li>
                                        {% if start_page > 2 %}
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                        {% endif %}
                                        {% endif %}
                                        
                                        {% for page_num in range(start_page, end_page + 1) %}
                                        {% if page_num == paginacao.pagina_atual %}
                                        <li class="page-item active" aria-current="page">
                                            <span class="page-link">{{ page_num }}</span>
                                        </li>
                                        {% else %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ url_for('admin', pagina=page_num, pesquisa=termo_pesquisa, criador=criador_filtro, data=data_busca, data_inicio=data_inicio, data_fim=data_fim) }}">{{ page_num }}</a>
                                        </li>
                                        {% endif %}
                                        {% endfor %}
                                        
                                        {% if end_page < paginacao.total_paginas %}
                                        {% if end_page < paginacao.total_paginas - 1 %}
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                        {% endif %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ url_for('admin', pagina=paginacao.total_paginas, pesquisa=termo_pesquisa, criador=criador_filtro, data=data_busca, data_inicio=data_inicio, data_fim=data_fim) }}">{{ paginacao.total_paginas }}</a>
                                        </li>
                                        {% endif %}
                                        
                                        <!-- Botão Próxima Página -->
                                        {% if paginacao.tem_proximo %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ url_for('admin', pagina=paginacao.pagina_atual+1, pesquisa=termo_pesquisa, criador=criador_filtro, data=data_busca, data_inicio=data_inicio, data_fim=data_fim) }}" aria-label="Próxima página">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                        {% else %}
                                        <li class="page-item disabled">
                                            <span class="page-link" aria-label="Próxima página">
                                                <i class="bi bi-chevron-right"></i>
                                            </span>
                                        </li>
                                        {% endif %}
                                        
                                        <!-- Botão Última Página -->
                                        {% if paginacao.pagina_atual < paginacao.total_paginas %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ url_for('admin', pagina=paginacao.total_paginas, pesquisa=termo_pesquisa, criador=criador_filtro, data=data_busca, data_inicio=data_inicio, data_fim=data_fim) }}" aria-label="Última página">
                                                <i class="bi bi-chevron-double-right"></i>
                                            </a>
                                        </li>
                                        {% else %}
                                        <li class="page-item disabled">
                                            <span class="page-link" aria-label="Última página">
                                                <i class="bi bi-chevron-double-right"></i>
                                            </span>
                                        </li>
                                        {% endif %}
                                    </ul>
                                </nav>
                            </div>
                            {% endif %}
                        {% else %}
                            <div class="alert alert-info">
                                {% if termo_pesquisa %}
                                    Nenhum produto encontrado para "{{ termo_pesquisa }}".
                                {% else %}
                                    Nenhuma lista de produtos foi enviada ainda.
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Confirmação de Validação -->
    <div class="modal fade" id="validarModal" tabindex="-1" aria-labelledby="validarModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="validarModalLabel">Confirmar Validação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p>Você está prestes a validar a lista de <span id="modal-usuario" class="fw-bold"></span>.</p>
                    <p>Esta ação registrará seu nome como validador e não poderá ser desfeita.</p>
                    <p>Deseja continuar?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success" id="confirmarValidacao">Confirmar Validação</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Flatpickr JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pt.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Configuração do Flatpickr para português brasileiro
            flatpickr.localize(flatpickr.l10ns.pt);

            // Função para converter data do formato dd/mm/yyyy para Date
            function parseDate(dateString) {
                if (!dateString) return null;
                const parts = dateString.split('/');
                if (parts.length === 3) {
                    return new Date(parts[2], parts[1] - 1, parts[0]);
                }
                return null;
            }

            // Date picker para data única
            const dataBuscaInput = document.getElementById('data_busca');
            const dataBuscaBtn = document.getElementById('data_busca_btn');
            const formDataUnica = document.getElementById('form_data_unica');
            
            if (dataBuscaInput && dataBuscaBtn) {
                const dataBuscaPicker = flatpickr(dataBuscaInput, {
                    dateFormat: "d/m/Y",
                    locale: "pt",
                    allowInput: false,
                    clickOpens: false,
                    defaultDate: parseDate(dataBuscaInput.value),
                    onChange: function(selectedDates, dateStr, instance) {
                        // Submeter o formulário automaticamente quando uma data é selecionada
                        if (dateStr) {
                            formDataUnica.submit();
                        }
                    }
                });

                // Evento para abrir o calendário ao clicar no botão
                dataBuscaBtn.addEventListener('click', function() {
                    dataBuscaPicker.open();
                });
            }

            // Date picker para período
            const dataInicioInput = document.getElementById('data_inicio');
            const dataFimInput = document.getElementById('data_fim');
            const periodoBuscaBtn = document.getElementById('periodo_busca_btn');
            const formPeriodo = document.getElementById('form_periodo');
            
            if (dataInicioInput && dataFimInput && periodoBuscaBtn) {
                const dataInicioPicker = flatpickr(dataInicioInput, {
                    dateFormat: "d/m/Y",
                    locale: "pt",
                    allowInput: false,
                    clickOpens: false,
                    defaultDate: parseDate(dataInicioInput.value),
                    onChange: function(selectedDates, dateStr, instance) {
                        // Configurar data mínima para data fim
                        if (selectedDates.length > 0) {
                            dataFimPicker.set('minDate', selectedDates[0]);
                            // Abrir automaticamente o picker da data fim
                            setTimeout(() => {
                                dataFimPicker.open();
                            }, 300);
                        }
                    }
                });

                const dataFimPicker = flatpickr(dataFimInput, {
                    dateFormat: "d/m/Y",
                    locale: "pt",
                    allowInput: false,
                    clickOpens: false,
                    defaultDate: parseDate(dataFimInput.value),
                    onChange: function(selectedDates, dateStr, instance) {
                        // Se ambas as datas estão preenchidas, submeter o formulário
                        if (dataInicioInput.value && dataFimInput.value) {
                            setTimeout(() => {
                                formPeriodo.submit();
                            }, 300);
                        }
                    }
                });

                // Evento para abrir o calendário de período ao clicar no botão
                periodoBuscaBtn.addEventListener('click', function() {
                    if (!dataInicioInput.value) {
                        dataInicioPicker.open();
                    } else if (!dataFimInput.value) {
                        dataFimPicker.open();
                    } else {
                        // Se ambas as datas estão preenchidas, submeter o formulário
                        formPeriodo.submit();
                    }
                });

                // Configurar restrições iniciais se já houver valores
                if (dataInicioInput.value) {
                    const dataInicio = parseDate(dataInicioInput.value);
                    if (dataInicio) {
                        dataFimPicker.set('minDate', dataInicio);
                    }
                }
            }

            // Resto do código JavaScript original...
            // Elementos do DOM
            const validarBtns = document.querySelectorAll('.validar-btn');
            const validarModal = new bootstrap.Modal(document.getElementById('validarModal'));
            const modalUsuario = document.getElementById('modal-usuario');
            const confirmarValidacaoBtn = document.getElementById('confirmarValidacao');
            
            let dataEnvioAtual = '';
            let nomeUsuarioAtual = '';
            
            // Configurar botões de validação
            validarBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    dataEnvioAtual = this.getAttribute('data-data-envio');
                    nomeUsuarioAtual = this.getAttribute('data-nome-usuario');
                    
                    modalUsuario.textContent = nomeUsuarioAtual;
                    validarModal.show();
                });
            });
            
            // Confirmar validação
            confirmarValidacaoBtn.addEventListener('click', function() {
                // Enviar requisição para validar a lista
                fetch('/api/validar-lista', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        data_envio: dataEnvioAtual,
                        nome_usuario: nomeUsuarioAtual
                    })
                })
                .then(response => response.json())
                .then(data => {
                    validarModal.hide();
                    
                    if (data.success) {
                        showNotification('Lista validada com sucesso!', 'success');
                        // Recarregar a página após 1 segundo
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        showNotification('Erro ao validar lista: ' + data.error, 'danger');
                    }
                })
                .catch(error => {
                    validarModal.hide();
                    showNotification('Erro ao processar requisição: ' + error, 'danger');
                });
            });
            
            // Função para exibir notificações
            window.showNotification = function(message, type) {
                const notification = document.getElementById('notification');
                const notificationMessage = document.getElementById('notification-message');
                
                notification.className = 'alert alert-' + type + ' alert-dismissible fade show';
                notificationMessage.textContent = message;
                notification.style.display = 'block';
                
                // Esconder automaticamente após 5 segundos
                setTimeout(() => {
                    hideNotification();
                }, 5000);
            };
            
            // Função para esconder notificações
            window.hideNotification = function() {
                const notification = document.getElementById('notification');
                notification.style.display = 'none';
            };
        });
    </script>
    
    <script>
    // ===== FUNCIONALIDADE DE SELEÇÃO EM LOTE =====
    
    document.addEventListener('DOMContentLoaded', function() {
        const selectAllCheckbox = document.getElementById('selectAllNaoValidadas');
        const clearSelectionBtn = document.getElementById('clearSelectionBtn');
        const validateSelectedBtn = document.getElementById('validateSelectedBtn');
        const selectedCountSpan = document.getElementById('selectedCount');
        
        // Função para atualizar contador e estado do botão
        function updateSelectionState() {
            const selectedCheckboxes = document.querySelectorAll('.lista-select:checked');
            const count = selectedCheckboxes.length;
            
            selectedCountSpan.textContent = count;
            validateSelectedBtn.disabled = count === 0;
            
            // Atualizar estado do checkbox "selecionar todas"
            const allNaoValidadas = document.querySelectorAll('.lista-select');
            if (allNaoValidadas.length > 0) {
                selectAllCheckbox.indeterminate = count > 0 && count < allNaoValidadas.length;
                selectAllCheckbox.checked = count === allNaoValidadas.length;
            }
        }
        
        // Event listener para checkbox "selecionar todas"
        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('.lista-select');
                checkboxes.forEach(checkbox => {
                    checkbox.checked = this.checked;
                });
                updateSelectionState();
            });
        }
        
        // Event listeners para checkboxes individuais
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('lista-select')) {
                updateSelectionState();
            }
        });
        
        // Event listener para botão limpar seleção
        if (clearSelectionBtn) {
            clearSelectionBtn.addEventListener('click', function() {
                const checkboxes = document.querySelectorAll('.lista-select');
                checkboxes.forEach(checkbox => {
                    checkbox.checked = false;
                });
                updateSelectionState();
            });
        }
        
        // Event listener para botão validar selecionadas
        if (validateSelectedBtn) {
            validateSelectedBtn.addEventListener('click', function() {
                const selectedCheckboxes = document.querySelectorAll('.lista-select:checked');
                
                if (selectedCheckboxes.length === 0) {
                    showNotification('Nenhuma lista selecionada', 'warning');
                    return;
                }
                
                // Coletar dados das listas selecionadas
                const listasSelecionadas = [];
                selectedCheckboxes.forEach(checkbox => {
                    listasSelecionadas.push({
                        data_envio: checkbox.dataset.dataEnvio,
                        nome_usuario: checkbox.dataset.nomeUsuario
                    });
                });
                
                // Mostrar modal de confirmação
                showValidationModal(listasSelecionadas);
            });
        }
        
        // Inicializar estado
        updateSelectionState();
    });
    
    // Função para mostrar modal de confirmação
    function showValidationModal(listas) {
        const modalHtml = `
            <div class="modal fade" id="confirmValidationModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirmar Validação em Lote</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>Você está prestes a validar <strong>${listas.length}</strong> lista(s):</p>
                            <ul class="list-group">
                                ${listas.map(lista => `
                                    <li class="list-group-item">
                                        <strong>${lista.nome_usuario}</strong> - ${lista.data_envio}
                                    </li>
                                `).join('')}
                            </ul>
                            <div class="alert alert-info mt-3">
                                <i class="bi bi-info-circle"></i>
                                Após a validação, uma lista unificada será criada automaticamente.
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-success" id="confirmValidationBtn">
                                <i class="bi bi-check-circle"></i> Confirmar Validação
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        // Remover modal anterior se existir
        const existingModal = document.getElementById('confirmValidationModal');
        if (existingModal) {
            existingModal.remove();
        }
        
        // Adicionar modal ao DOM
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        
        // Mostrar modal
        const modal = new bootstrap.Modal(document.getElementById('confirmValidationModal'));
        modal.show();
        
        // Event listener para confirmação
        document.getElementById('confirmValidationBtn').addEventListener('click', function() {
            modal.hide();
            executeValidation(listas);
        });
    }
    
    // Função para executar validação em lote
    function executeValidation(listas) {
        showNotification('Processando validação em lote...', 'info');
        
        fetch('/api/validar-listas-lote', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ listas: listas })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message, 'success');
                // Recarregar página após 2 segundos
                setTimeout(() => {
                    window.location.reload();
                }, 2000);
            } else {
                showNotification(data.error || 'Erro ao validar listas', 'danger');
            }
        })
        .catch(error => {
            console.error('Erro:', error);
            showNotification('Erro ao processar validação', 'danger');
        });
    }
    
    </script>
</body>
</html>

